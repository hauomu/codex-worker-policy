{
  "version": "routing-v4-public",
  "local": {
    "enabled": false,
    "note": "Set enabled to true only after installing a local worker MCP server. See references/local-workers.md.",
    "server": "local_worker",
    "tools": []
  },
  "roles": {
    "LOCAL_DEFAULT": null,
    "LOCAL_QUALITY": null,
    "LOCAL_ALTERNATE": null,
    "FRONTIER_WORKER": {"model": "gpt-6-luna", "effort": "high"},
    "FRONTIER_RETRY": {"model": "gpt-6-luna", "effort": "max"},
    "SOL_WORKER": {"model": "gpt-6.1-sol", "effort": "low"},
    "SOL_RETRY": {"model": "gpt-6.1-sol", "effort": "medium"},
    "CLEANUP_WORKER": {"model": "gpt-6-luna", "effort": "high"}
  },
  "ladders": {
    "default": ["FRONTIER_WORKER", "FRONTIER_RETRY", "SOL_WORKER"],
    "terminal": ["SOL_WORKER", "SOL_RETRY"]
  },
  "kindLadders": {
    "debugging": "terminal",
    "testing": "terminal",
    "build": "terminal",
    "environment": "terminal"
  },
  "cleanup": {
    "defaultBudgetLines": 200,
    "maxCommentRatio": 0.35
  },
  "disabledModels": []
}
